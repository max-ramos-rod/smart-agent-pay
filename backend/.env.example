# Database
DATABASE_URL=postgresql+asyncpg://smartpay_user:smartpay_pass@localhost:5432/smartpay_db

# JWT
SECRET_KEY=troque-por-uma-string-aleatoria-longa
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Solana (JSON array de 64 bytes da keypair)
SOLANA_PRIVATE_KEY=[0,0,0,...]

# CORS — origens permitidas separadas por vírgula (opcional, padrão cobre localhost dev)
# ALLOWED_ORIGINS=["http://localhost:8080","https://meuapp.com"]

# OpenAI (opcional - necessário apenas se USE_AI=true)
OPENAI_API_KEY=sk-proj-...
USE_AI=false
AI_TIMEOUT_SECONDS=5
